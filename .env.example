DISCORD_BOT_TOKEN=
TRADIER_API_KEY=
# https://api.tradier.com (requires market-data entitlement) or https://sandbox.tradier.com (delayed)
TRADIER_BASE_URL=https://api.tradier.com
# Set to 15 when using delayed sandbox data so freshness checks account for the delay
DATA_DELAY_MINUTES=0
SIGNALS_CHANNEL_ID=
# Policy allows only SPY, QQQ, IWM
WATCHLIST=SPY,QQQ,IWM
MAX_SIGNALS_PER_CYCLE=3
MAX_SIGNALS_PER_DAY=6
CYCLE_SECONDS=900
MENTION_EVERYONE=false
# Policy bounds: 1-7 DTE, $200 max premium. Values outside are clamped to the policy.
MIN_DTE=1
MAX_DTE=7
MAX_PREMIUM_USD=200
MIN_OPEN_INTEREST=100
MAX_SPREAD_PCT=0.15
